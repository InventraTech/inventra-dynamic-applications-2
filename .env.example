# Origem da API no servidor, sem o sufixo /api.
# Em desenvolvimento, use o endereço onde o backend está disponível.
API_ORIGIN=http://localhost:8080

# Base HTTP(S) do serviço de IA quando ele estiver em outra origem.
# Se omitida, o Vite usa localhost:8000 para uma API local e deriva /ia do API_ORIGIN remoto.
# Na Vercel, o padrão também é a origem de API_ORIGIN com o caminho /ia.
# IA_ORIGIN=http://localhost:8000

# O navegador sempre usa a rota relativa atendida pelo proxy.
VITE_API_BASE_URL=/api
