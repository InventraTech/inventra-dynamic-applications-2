{
  "name": "inventra-dynamic-applications-2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "test:accessibility": "tsc -p tests/tsconfig.json && node --experimental-strip-types --test tests/accessibility-settings.test.ts",
    "test:dashboard": "tsc -p tests/tsconfig.json && node --experimental-strip-types --test tests/dashboard.test.ts",
    "dev:dashboard-validation": "vite --config tests/dashboard/vite.config.ts --open /tests/dashboard/index.html",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/k2d": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
